# Application & Ports
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8301
API_BASE_URL=http://localhost:8301
STREAMLIT_PORT=8501

# Docker Compose Project Isolation
COMPOSE_PROJECT_NAME=ai01_policylens_rag

# Qdrant Vector Store (leave QDRANT_URL blank for zero-Docker local storage)
QDRANT_PATH=./qdrant_storage
QDRANT_URL=
QDRANT_COLLECTION=policylens_chunks

# Embedding Provider: local | openai | gemini | ollama
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
EMBEDDING_MODEL=text-embedding-3-small

# LLM Provider: local | openai | gemini | ollama
LLM_PROVIDER=local
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
GEMINI_API_KEY=
LLM_TIMEOUT_SECONDS=20.0
LLM_MAX_RETRIES=2

# Reranker Provider: local | jina | cohere
RERANKER_PROVIDER=local
RERANKER_API_KEY=
RERANKER_MODEL=jina-reranker-v2-base-multilingual

# Chunking, Retrieval & Abstention Guardrails
CHUNK_SIZE=900
CHUNK_OVERLAP=150
TOP_K_DENSE=15
TOP_K_SPARSE=15
TOP_K_FINAL=4
RRF_K=60
ABSTENTION_THRESHOLD=0.34
MAX_QUERY_CHARS=1000
